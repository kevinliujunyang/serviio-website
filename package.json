{
  "name": "serviio-website",
  "version": "1.0.0",
  "description": "Serviio - AI Voice Agent for Restaurants",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "validate:seo": "node scripts/validate-seo.js",
    "smoke:http": "node scripts/http-smoke.js",
    "smoke:prod": "node scripts/http-smoke.js https://serviio.ai",
    "sitemap:sync": "node scripts/sync-sitemap-lastmod.js",
    "indexing:urls": "node scripts/print-indexing-urls.js",
    "indexnow:payload": "node scripts/submit-indexnow.js",
    "indexnow:submit": "node scripts/submit-indexnow.js --submit",
    "leads:score": "node scripts/score-formspree-leads.js",
    "leads:test": "node scripts/test-lead-scoring.js",
    "search:analyze": "node scripts/analyze-search-console.js",
    "search:test": "node scripts/test-search-console-analyzer.js",
    "seo:coverage": "node scripts/audit-keyword-coverage.js",
    "marketing:tracker": "node scripts/generate-free-search-tracker.js",
    "marketing:prospects": "node scripts/print-free-search-prospect-queries.js",
    "marketing:summary": "node scripts/summarize-free-search-tracker.js",
    "marketing:packets": "node scripts/print-free-search-submission-packets.js",
    "marketing:next": "node scripts/print-free-search-next-actions.js",
    "generate:city-pages": "node scripts/generate-service-area-city-pages.js",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
